# Copy to .env (which is gitignored) and fill in.
# SOPS/age is the right answer once there is a deploy target. There is not one
# yet, so a gitignored .env plus this committed template is the honest choice.

# Which price feed the snapshotter records from: polygon | alpaca
# See packages/snapshotter/src/asetpay_snapshotter/sources.py for the free-tier
# request maths that decides this. polygon is the default: one request a night
# for the whole US market, and CONSOLIDATED volume rather than one venue's.
PRICE_SOURCE=polygon

# P1-14b(i) — free Polygon "Stocks Basic" key. Data only, no brokerage, no
# jurisdictional eligibility question. This is the research feed.
POLYGON_API_KEY=

# P1-14b(ii) — free Alpaca paper account. An alternative price feed, and a
# candidate Phase 4 broker where residency allows it. Broker eligibility is a
# Phase 4 question and deliberately does NOT gate the feed above.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_FEED=iex        # sip once a paid data subscription exists

# P1-14a — SEC requires a declared User-Agent with contact details.
# Requests without one are throttled or blocked. Keep under 10 req/s.
SEC_USER_AGENT="AsetPay Research your.email@example.com"

# Local Postgres (native install, no Docker)
DATABASE_URL=postgresql://localhost:5432/asetpay

# Where snapshots land before upload to a GitHub Release
SNAPSHOT_DIR=./data/snapshots
