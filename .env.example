# Copy to .env (which is gitignored) and fill in.
# SOPS/age is the right answer once there is a deploy target. There is not one
# yet, so a gitignored .env plus this committed template is the honest choice.

# P1-14b — free Alpaca paper account. Price feed AND Phase 4 broker.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# P1-14a — SEC requires a declared User-Agent with contact details.
# Requests without one are throttled or blocked. Keep under 10 req/s.
SEC_USER_AGENT=AsetPay Research your.email@example.com

# Local Postgres (native install, no Docker)
DATABASE_URL=postgresql://localhost:5432/asetpay

# Where snapshots land before upload to a GitHub Release
SNAPSHOT_DIR=./data/snapshots
